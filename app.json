{
  "expo": {
    "name": "AstroToolkit",
    "slug": "the-complete-astro-toolkit",
    "version": "1.6.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "astrotoolkit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your selected observatory devices on local Wi-Fi.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      },
      "supportsTablet": true,
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.csoaoe.astrotoolkit",
      "versionCode": 9,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#050812"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow AstroToolkit to use your location to calculate which deep-sky targets are visible tonight."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AstroToolkit to select your astrophotography image layers.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050812",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-sharing",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a5a1829-ff55-406e-844d-5a542bd86334"
      }
    },
    "owner": "stuartthealiens-team"
  }
}
